{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/server.js"
    },
    {
      "source": "/jobs/(.*)",
      "destination": "/server/server.js"
    },
    {
      "source": "/jobs",
      "destination": "/server/server.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/client/assets/$1"
    },
    {
      "source": "/computer.png",
      "destination": "/client/computer.png"
    },
    {
      "source": "/icons.svg",
      "destination": "/client/icons.svg"
    },
    {
      "source": "/(.*)",
      "destination": "/client/index.html"
    }
  ]
}